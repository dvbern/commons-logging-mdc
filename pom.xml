<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>ch.dvbern.oss.maven</groupId>
		<artifactId>parent-minimal</artifactId>
		<version>5.0.4</version>
	</parent>

	<groupId>ch.dvbern.oss.commons-logging-mdc</groupId>
	<artifactId>dvb-commons-logging-mdc-parent</artifactId>
	<name>dvb-commons-logging-mdc-parent</name>
	<packaging>pom</packaging>
	<version>1.0.1-SNAPSHOT</version>

	<!-- *********************** Release HowTo *********************************************** -->
	<!-- * run `./release.sh -p`                                                             * -->
	<!-- * Then check that everything is pushed                                              * -->
	<!-- * and start the github action ***on the newly created version tag***                * -->
	<!-- * https://github.com/dvbern/commons-logging-mdc/actions/workflows/maven-publish.yml * -->
	<!-- ************************************************************************************* -->

	<!-- <editor-fold desc="properties" defaultstate="collapsed"> -->
	<properties>
		<maven-compiler-plugin.javaversion>17</maven-compiler-plugin.javaversion>

		<slf4j.version>2.0.17</slf4j.version>
		<spotbugs-annotations.version>4.8.3</spotbugs-annotations.version>
		<junit.jupiter.version>6.0.3</junit.jupiter.version>
		<mockito-junit-jupiter.version>5.23.0</mockito-junit-jupiter.version>

		<spotbugs-maven-plugin.version>4.9.8.3</spotbugs-maven-plugin.version>
		<maven-pmd-plugin.version>3.28.0</maven-pmd-plugin.version>
		<maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
		<!-- See https://checkstyle.sourceforge.io/ for java version compatibility -->
		<maven-checkstyle.version>12.3.1</maven-checkstyle.version>
		<maven-surefire-plugin.version>3.5.5</maven-surefire-plugin.version>
		<jacoco-maven-plugin.version>0.8.14</jacoco-maven-plugin.version>

		<!-- ! keep in sync with .mvn/maven-wrapper.properties ! -->
		<maven-enforcer-plugin.requireMavenVersion.version>[3.9.15]</maven-enforcer-plugin.requireMavenVersion.version>
		<maven-enforcer-plugin.requireJavaVersion.version>${maven-compiler-plugin.javaversion}</maven-enforcer-plugin.requireJavaVersion.version>
	</properties>
	<!-- </editor-fold> -->

	<description>This Java library contains helpers filling standard logging MDC fields expected in all apps.</description>
	<url>https://github.com/dvbern/commons-logging-mdc</url>

	<!-- <editor-fold desc="organization" defaultstate="collapsed"> -->
	<organization>
		<name>DV Bern AG</name>
		<url>https://www.dvbern.ch</url>
	</organization>
	<!-- </editor-fold> -->

	<!-- <editor-fold desc="licenses" defaultstate="collapsed"> -->
	<licenses>
		<license>
			<name>Apache License, Version 2.0</name>
			<url>https://www.apache.org/licenses/LICENSE-2.0</url>
			<distribution>repo</distribution>
		</license>
	</licenses>
	<!-- </editor-fold> -->

	<!-- <editor-fold desc="modules" defaultstate="collapsed"> -->
	<modules>
		<module>api</module>
		<module>jaxrs-filter</module>
	</modules>
	<!-- </editor-fold> -->

	<!-- <editor-fold desc="scm" defaultstate="collapsed"> -->
	<scm>
		<connection>scm:git:git://github.com/dvbern/commons-logging-mdc.git</connection>
		<developerConnection>scm:git:ssh://github.com:dvbern/commons-logging-mdc.git</developerConnection>
		<url>https://github.com/dvbern/commons-logging-mdc.git</url>
	</scm>
	<!-- </editor-fold> -->

	<!-- <editor-fold desc="issueManagement" defaultstate="collapsed"> -->
	<issueManagement>
		<system>GitHub</system>
		<url>https://github.com/dvbern/commons-logging-mdc/issues</url>
	</issueManagement>
	<!-- </editor-fold> -->

	<!-- <editor-fold desc="ciManagement" defaultstate="collapsed"> -->
	<ciManagement>
		<system>GitHub Actions</system>
		<url>https://github.com/dvbern/commons-logging-mdc/actions</url>
	</ciManagement>
	<!-- </editor-fold> -->

	<!-- <editor-fold desc="dependencyManagement" defaultstate="collapsed"> -->
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.junit</groupId>
				<artifactId>junit-bom</artifactId>
				<version>${junit.jupiter.version}</version>
				<scope>import</scope>
				<type>pom</type>
			</dependency>

			<dependency>
				<groupId>ch.dvbern.oss.commons-logging-mdc</groupId>
				<artifactId>dvb-commons-logging-mdc-api</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>ch.dvbern.oss.commons-logging-mdc</groupId>
				<artifactId>dvb-commons-logging-mdc-jaxrs-filter</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>org.projectlombok</groupId>
				<artifactId>lombok</artifactId>
				<version>1.18.46</version>
			</dependency>
			<dependency>
				<groupId>org.jspecify</groupId>
				<artifactId>jspecify</artifactId>
				<version>1.0.0</version>
			</dependency>
			<dependency>
				<groupId>com.github.spotbugs</groupId>
				<artifactId>spotbugs-annotations</artifactId>
				<version>4.9.8</version>
			</dependency>
			<dependency>
				<groupId>jakarta.annotation</groupId>
				<artifactId>jakarta.annotation-api</artifactId>
				<version>2.1.1</version>
			</dependency>
			<dependency>
				<groupId>jakarta.enterprise</groupId>
				<artifactId>jakarta.enterprise.cdi-api</artifactId>
				<version>3.0.1</version>
			</dependency>
			<dependency>
				<groupId>org.slf4j</groupId>
				<artifactId>slf4j-api</artifactId>
				<version>${slf4j.version}</version>
			</dependency>
			<dependency>
				<groupId>org.slf4j</groupId>
				<artifactId>slf4j-simple</artifactId>
				<version>${slf4j.version}</version>
			</dependency>
			<dependency>
				<groupId>org.mockito</groupId>
				<artifactId>mockito-core</artifactId>
				<version>${mockito-junit-jupiter.version}</version>
			</dependency>
			<dependency>
				<groupId>org.mockito</groupId>
				<artifactId>mockito-junit-jupiter</artifactId>
				<version>${mockito-junit-jupiter.version}</version>
			</dependency>
			<dependency>
				<groupId>org.assertj</groupId>
				<artifactId>assertj-core</artifactId>
				<version>3.27.7</version>
			</dependency>
		</dependencies>
	</dependencyManagement>
	<!-- </editor-fold> -->

	<build>
		<plugins>
			<!-- <editor-fold desc="maven-checkstyle-plugin" defaultstate="collapsed"> -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-checkstyle-plugin</artifactId>
			</plugin>
			<!-- </editor-fold> -->

			<!-- <editor-fold desc="maven-pmd-plugin" defaultstate="collapsed"> -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-pmd-plugin</artifactId>
			</plugin>
			<!-- </editor-fold> -->

			<!-- <editor-fold desc="spotbugs-maven-plugin" defaultstate="collapsed"> -->
			<plugin>
				<groupId>com.github.spotbugs</groupId>
				<artifactId>spotbugs-maven-plugin</artifactId>
			</plugin>
			<!-- </editor-fold> -->

			<!-- <editor-fold desc="jandex-maven-plugin" defaultstate="collapsed"> -->
			<plugin>
				<groupId>io.smallrye</groupId>
				<artifactId>jandex-maven-plugin</artifactId>
				<version>3.5.3</version>
				<executions>
					<execution>
						<id>make-index</id>
						<goals>
							<goal>jandex</goal>
						</goals>
						<!-- phase is 'process-classes by default' -->
					</execution>
				</executions>
			</plugin>
			<!-- </editor-fold> -->

			<!-- <editor-fold desc="jacoco-maven-plugin" defaultstate="collapsed"> -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>${jacoco-maven-plugin.version}</version>
				<configuration>
					<excludes>
						<exclude>com/baeldung/**/ExcludedPOJO.class</exclude>
						<exclude>com/baeldung/**/*DTO.*</exclude>
						<exclude>**/config/*</exclude>
					</excludes>
				</configuration>
				<executions>
					<execution>
						<id>jacoco-initialize</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>jacoco-site</id>
						<phase>verify</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
					<execution>
						<id>check-coverage</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
						<configuration>
							<rules>
								<rule>
									<element>BUNDLE</element>
									<limits>
										<limit>
											<counter>INSTRUCTION</counter>
											<value>COVEREDRATIO</value>
											<minimum>1</minimum>
										</limit>
										<limit>
											<counter>BRANCH</counter>
											<value>COVEREDRATIO</value>
											<minimum>1</minimum>
										</limit>
									</limits>
								</rule>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!-- </editor-fold> -->

			<!-- <editor-fold desc="maven-javadoc-plugin" defaultstate="collapsed"> -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-javadoc-plugin</artifactId>
				<configuration>
					<doclint>all,-missing</doclint>
				</configuration>
			</plugin>
			<!-- </editor-fold> -->

			<!-- <editor-fold desc="versions-maven-plugin" defaultstate="collapsed"> -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>versions-maven-plugin</artifactId>
				<version>2.21.0</version>
				<configuration>
					<ruleSet>
						<ignoreVersions>
							<ignoreVersion>
								<type>regex</type>
								<version>.*RC.*</version>
							</ignoreVersion>
							<ignoreVersion>
								<type>regex</type>
								<version>.*alpha.*</version>
							</ignoreVersion>
							<ignoreVersion>
								<type>regex</type>
								<version>.*beta.*</version>
							</ignoreVersion>
							<ignoreVersion>
								<type>regex</type>
								<version>.*redhat.*</version>
							</ignoreVersion>
							<ignoreVersion>
								<type>regex</type>
								<version>.*-M\d+</version>
							</ignoreVersion>
						</ignoreVersions>
					</ruleSet>
				</configuration>
			</plugin>
			<!-- </editor-fold> -->
		</plugins>
	</build>

	<profiles>
		<!-- <editor-fold desc="maven-central" defaultstate="collapsed"> -->
		<profile>
			<id>maven-central</id>
			<properties>
				<skip-javadoc/>
			</properties>
		</profile>
		<!-- </editor-fold> -->
	</profiles>
</project>
